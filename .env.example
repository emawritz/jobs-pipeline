# Copy to .env (gitignored) and fill in your real values.

# ── REQUIRED ──────────────────────────────────────────────────────────────

# Anthropic API key for Claude drafts (cover letters, short answers, scoring).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Your name as it should appear in email signatures.
SENDER_NAME="Your Name"

# Your email — used as From address when sending via Mail.app, and as
# self-detection in Gmail polling.
SENDER_EMAIL="your@email.com"

# Absolute path to your PDF resume — attached to email applications.
RESUME_PATH="${HOME}/jobs-pipeline/cv/cv.pdf"

# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Your portfolio URL — appears in email signatures and Claude prompts.
PORTFOLIO_URL="https://yourportfolio.com"

# Get from https://2captcha.com (~$5 = 1500 captcha solves). Used by the
# workana/freelance registration scripts. Without this, --skip-captcha
# must be used or the job blocks waiting for human input.
TWO_CAPTCHA_API_KEY=
