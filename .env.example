# Copy to .env (gitignored) and fill in your real values.
# The agent loads this file automatically at startup via lib/env.ts.

# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Path to the Claude Code CLI binary. Defaults to "claude" (in PATH).
# Install Claude Code first: https://claude.com/claude-code
# The agent shells out to this binary for cover letters and scoring — your
# Claude Code subscription covers the cost, $0 in API spend.
CLAUDE_BIN=claude

# Optional 2captcha API key for the workana / freelance registration scripts.
# Get from https://2captcha.com (~$5 = 1500 captcha solves). Without this,
# pass --skip-captcha to those scripts or they'll block waiting for human input.
TWO_CAPTCHA_API_KEY=

# ── EVERYTHING ELSE LIVES IN data/answers.json + MASTER.md ───────────────
#
# Your name, email, phone, salary band, portfolio URL, resume path, etc. all
# live in data/answers.json. Edit that file, not env vars.
#
# Your projects + metrics live in MASTER.md. The agent reads it on every
# draft to map your work to each posting.
