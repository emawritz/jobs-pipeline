<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.jobs-pipeline.gmail-poll</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_PATH__/bin/gmail-poll-cron.sh</string>
  </array>

  <!--
    Poll every 10 min while logged in. launchd guarantees at-most-one in
    flight (StartInterval coalesces if previous run hasn't finished).
  -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_PATH__/data/gmail/cron-logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_PATH__/data/gmail/cron-logs/launchd.err.log</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_PATH__</string>
</dict>
</plist>
