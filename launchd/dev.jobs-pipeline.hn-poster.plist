<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.jobs-pipeline.hn-poster</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_PATH__/bin/hn-post-loop.sh</string>
  </array>

  <!--
    Fires at 12:00 local time (GMT-3) on the 1st of each month.
    That's 11:00 ET — when whoishiring historically posts the monthly threads.
    The wrapper polls for up to 2h waiting for the thread to appear.
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__PROJECT_PATH__/data/hn-logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_PATH__/data/hn-logs/launchd.err.log</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_PATH__</string>
</dict>
</plist>
